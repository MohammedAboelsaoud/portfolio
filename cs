<script>
(function(){
  var chip=document.getElementById('chip');
  var steps=[].slice.call(document.querySelectorAll('.step'));
  function show(n){steps.forEach(function(s){if(+s.dataset.step<=n)s.classList.remove('hidden');});}
  function status(s,t){chip.dataset.s=s;chip.textContent=t;}
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce){show(3);status('resolved','Resolved');return;}
  setTimeout(function(){status('investigating','Investigating');show(1);},1100);
  setTimeout(function(){show(2);},2400);
  setTimeout(function(){status('resolved','Resolved');show(3);},3700);
})();
</script>
