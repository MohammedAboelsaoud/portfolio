<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Muhammed Aboelsaoud – Customer Care Representative</title>
<meta name="description" content="Bilingual English–Arabic customer care representative in Cairo, Egypt. Phone, email and chat support, complaint handling, follow-up and team leadership.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#F2F5F3; --surface:#FFFFFF; --ink:#10262B; --muted:#56696C; --line:#D7E0DD;
  --teal:#0E6E66; --teal-soft:#DCEDEA; --amber:#B77C00; --amber-soft:#FBEFD2;
  --blue:#2A62C9; --blue-soft:#E1EAFB; --green:#1B8A50; --green-soft:#DDF2E5;
  --band:#10262B; --band-ink:#EAF2F0;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#0C1B1E; --surface:#132A2E; --ink:#E4EEEC; --muted:#97ABAC; --line:#244046;
    --teal:#56C6B8; --teal-soft:#15393A; --amber:#E7B347; --amber-soft:#3A2F14;
    --blue:#7FA7F0; --blue-soft:#1C2B47; --green:#5BCB8C; --green-soft:#153524;
    --band:#07292A; --band-ink:#E4EEEC;
  }
}
:root[data-theme="dark"]{
  --paper:#0C1B1E; --surface:#132A2E; --ink:#E4EEEC; --muted:#97ABAC; --line:#244046;
  --teal:#56C6B8; --teal-soft:#15393A; --amber:#E7B347; --amber-soft:#3A2F14;
  --blue:#7FA7F0; --blue-soft:#1C2B47; --green:#5BCB8C; --green-soft:#153524;
  --band:#07292A; --band-ink:#E4EEEC;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 72px)}
body{margin:0;background:var(--paper);color:var(--ink);font-family:"Readex Pro",system-ui,"Segoe UI",Tahoma,Arial,sans-serif;font-size:17px;line-height:1.6;font-weight:300;-webkit-font-smoothing:antialiased}
img{max-width:100%}
a{color:inherit}
:focus-visible{outline:3px solid var(--teal);outline-offset:3px;border-radius:6px}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
h1,h2,h3{font-weight:600;line-height:1.15;margin:0;letter-spacing:-0.01em}
p{margin:0}
[lang="ar"]{font-family:"Readex Pro",Tahoma,"Segoe UI",sans-serif;letter-spacing:0}

/* Nav */
.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;background:color-mix(in srgb,var(--paper) 88%,transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:64px;gap:16px}
.mark{display:flex;align-items:center;gap:10px;text-decoration:none;font-weight:500}
.mark span.m{display:grid;place-items:center;width:36px;height:36px;border-radius:10px;background:var(--teal);color:var(--paper);font-weight:600;font-size:15px}
.nav ul{display:flex;gap:28px;list-style:none;margin:0;padding:0}
.nav ul a{text-decoration:none;color:var(--muted);font-size:15px;font-weight:400}
.nav ul a:hover{color:var(--ink)}
.btn{white-space:nowrap;display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border-radius:999px;font:500 15px/1 "Readex Pro",system-ui,sans-serif;text-decoration:none;border:1.5px solid var(--teal);transition:background .15s,color .15s}
.btn.solid{background:var(--teal);color:var(--paper)}
.btn.solid:hover{background:transparent;color:var(--teal)}
.btn.ghost{color:var(--teal)}
.btn.ghost:hover{background:var(--teal-soft)}
.nav .btn{padding:10px 16px}

/* Hero */
.hero{padding:72px 0 64px}
.hero .wrap{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,0.85fr);gap:56px;align-items:center}
.avail{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:400;color:var(--green);background:var(--green-soft);padding:6px 12px;border-radius:999px;margin-bottom:24px}
.avail::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--green)}
.hero h1{font-size:clamp(40px,5.4vw,62px);font-weight:600;letter-spacing:-0.025em;line-height:1.02}
.hero .ar-name{text-align:left;font-size:clamp(26px,3.4vw,38px);color:var(--teal);font-weight:400;margin-top:12px;line-height:1.3}
.hero .lede{font-size:clamp(18px,1.8vw,21px);color:var(--ink);max-width:34ch;margin-top:28px;line-height:1.5}
.hero .role{color:var(--muted);font-size:16px;margin-top:10px}
.cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
.facts{display:grid;grid-template-columns:repeat(4,auto);gap:0;margin-top:44px;justify-content:start}
.facts div{padding:0 16px;border-left:1px solid var(--line);font-size:14px;color:var(--muted);line-height:1.35}
.facts div:first-child{padding-left:0;border-left:0}
.facts b{display:block;color:var(--ink);font-weight:500;font-size:15px}

/* Ticket */
.ticket{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:22px;box-shadow:0 1px 0 var(--line),0 24px 48px -28px rgba(16,38,43,.35)}
.t-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding-bottom:14px;border-bottom:1px dashed var(--line)}
.t-head .t-id{font-size:13px;color:var(--muted)}
.t-head .t-id strong{display:block;color:var(--ink);font-weight:500;font-size:15px}
.chip{font-size:13px;font-weight:500;padding:5px 12px;border-radius:999px;white-space:nowrap;transition:background .3s,color .3s}
.chip[data-s="open"]{background:var(--amber-soft);color:var(--amber)}
.chip[data-s="investigating"]{background:var(--blue-soft);color:var(--blue)}
.chip[data-s="resolved"]{background:var(--green-soft);color:var(--green)}
.msgs{display:flex;flex-direction:column;gap:10px;padding-top:16px}
.msg{max-width:88%;padding:11px 14px;border-radius:14px;font-size:15px;line-height:1.45}
.msg small{display:block;font-size:12px;color:var(--muted);margin-bottom:3px}
.msg.cust{background:var(--paper);border-top-left-radius:4px}
.msg.note{align-self:center;max-width:100%;background:transparent;border:1px dashed var(--line);color:var(--muted);font-size:13.5px;text-align:center;border-radius:10px}
.msg.me{align-self:flex-end;background:var(--teal);color:var(--paper);border-top-right-radius:4px}
.msg.me small{color:color-mix(in srgb,var(--paper) 75%,transparent)}
.step{transition:opacity .45s ease,transform .45s ease}
.step.hidden{opacity:0;transform:translateY(6px)}
.t-foot{margin-top:14px;padding-top:12px;border-top:1px dashed var(--line);display:flex;justify-content:space-between;gap:10px;font-size:13px;color:var(--muted)}
.t-foot .ok{color:var(--green);font-weight:500}
.ticket-cap{font-size:13px;color:var(--muted);margin-top:12px;text-align:center}

/* Sections */
section.block{padding:88px 0;border-top:1px solid var(--line)}
.sec-head{display:grid;grid-template-columns:300px 1fr;gap:48px;margin-bottom:48px;align-items:end}
.sec-head h2{font-size:clamp(28px,3.2vw,40px)}
.sec-head p{color:var(--muted);max-width:60ch}

/* About */
.about{display:grid;grid-template-columns:300px 1fr;gap:48px}
.about h2{font-size:clamp(28px,3.2vw,40px)}
.about .copy p{font-size:19px;line-height:1.65;max-width:62ch}
.about .copy p + p{margin-top:18px;color:var(--muted);font-size:17px}

/* Process */
.process{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,1fr);gap:0;counter-reset:s;position:relative}
.process li{padding:0 20px 0 0;counter-increment:s;position:relative}
.process li::before{content:counter(s);display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--surface);border:1.5px solid var(--teal);color:var(--teal);font-weight:600;font-size:15px;position:relative;z-index:1;margin-bottom:18px}
.process li::after{content:"";position:absolute;top:20px;left:40px;right:0;height:1.5px;background:var(--line)}
.process li:last-child::after{display:none}
.process h3{font-size:19px;margin-bottom:8px}
.process p{font-size:15px;color:var(--muted);line-height:1.55}

/* Experience */
.jobs{display:flex;flex-direction:column}
.job{display:grid;grid-template-columns:300px 1fr;gap:48px;padding:32px 0;border-top:1px solid var(--line)}
.job:first-child{border-top:0;padding-top:0}
.job .when{font-size:15px;color:var(--muted)}
.job .when b{display:block;color:var(--ink);font-weight:500;font-size:16px;margin-bottom:2px}
.job h3{font-size:22px}
.job .org{color:var(--teal);font-weight:400;margin:4px 0 14px}
.job ul{margin:0;padding-left:20px}
.job li{margin:6px 0;max-width:68ch}
.job li::marker{color:var(--teal)}
.promo{display:inline-block;font-size:13px;font-weight:500;color:var(--teal);background:var(--teal-soft);padding:3px 10px;border-radius:999px;margin-left:8px;vertical-align:middle}

/* Skills */
.skills{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}
.skills div{border-top:3px solid var(--teal);padding-top:20px}
.skills h3{font-size:19px;margin-bottom:14px}
.skills ul{list-style:none;margin:0;padding:0}
.skills li{padding:9px 0;border-bottom:1px solid var(--line);font-size:16px}
.skills li:last-child{border-bottom:0}

/* Languages */
.langs{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:20px;overflow:hidden;background:var(--surface)}
.lang{padding:40px}
.lang + .lang{border-left:1px solid var(--line)}
.lang .say{font-size:clamp(24px,2.8vw,34px);font-weight:500;line-height:1.3;color:var(--ink)}
.lang .say[lang="ar"]{text-align:right;line-height:1.5}
.lang dl{margin:24px 0 0;display:grid;grid-template-columns:auto 1fr;gap:6px 16px;font-size:15px}
.lang dt{color:var(--muted)}
.lang dd{margin:0;font-weight:400}

/* Education */
.edu{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}
.edu h3{font-size:18px;margin-bottom:6px}
.edu p{color:var(--muted);font-size:15px}
.edu .d{color:var(--ink);font-size:14px;margin-top:8px}

/* Contact */
.contact{background:var(--band);color:var(--band-ink);padding:96px 0}
.contact h2{font-size:clamp(32px,4.6vw,54px);max-width:18ch;letter-spacing:-0.02em}
.contact p.sub{margin-top:18px;font-size:18px;opacity:.8;max-width:52ch}
.contact .grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:0;margin-top:48px;border-top:1px solid color-mix(in srgb,var(--band-ink) 20%,transparent)}
.contact a.c{display:block;padding:22px 20px 22px 0;text-decoration:none;border-right:1px solid color-mix(in srgb,var(--band-ink) 20%,transparent);margin-right:20px}
.contact a.c:last-child{border-right:0;margin-right:0}
.contact a.c span{display:block;font-size:14px;opacity:.65;margin-bottom:4px}
.contact a.c b{font-weight:500;font-size:16px;word-break:break-word}
.contact a.c:hover b{text-decoration:underline;text-underline-offset:4px}
footer{background:var(--band);color:var(--band-ink);opacity:1;font-size:14px;padding:0 0 32px}
footer .wrap{opacity:.6}

/* Responsive */
@media (max-width:960px){
  .hero .wrap{grid-template-columns:1fr;gap:48px}
  .sec-head,.about,.job{grid-template-columns:1fr;gap:16px}
  .process{grid-template-columns:1fr;gap:28px}
  .process li{padding:0 0 0 60px}
  .process li::before{position:absolute;left:0;top:0;margin:0}
  .process li::after{top:44px;left:19px;right:auto;width:1.5px;height:calc(100% - 16px)}
  .skills,.edu{grid-template-columns:1fr;gap:32px}
  .contact .grid{grid-template-columns:1fr 1fr}
  .contact a.c{border-right:0;margin-right:0;border-bottom:1px solid color-mix(in srgb,var(--band-ink) 20%,transparent)}
}
@media (max-width:720px){
  .nav ul{display:none}
  .mark .nm{display:none}
  .hero{padding:44px 0 48px}
  .facts{grid-template-columns:1fr 1fr;gap:18px 0}
  .facts div:nth-child(3){padding-left:0;border-left:0}
  .langs{grid-template-columns:1fr}
  .lang{padding:28px}
  .lang + .lang{border-left:0;border-top:1px solid var(--line)}
  section.block{padding:64px 0}
  .contact{padding:72px 0}
  .contact .grid{grid-template-columns:1fr}
}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  .step,.chip{transition:none}
}
</style>
</head>
