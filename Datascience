.path .note{font-size:.98rem;max-width:var(--measure)}

/* ---------- languages ---------- */
.langs{list-style:none;margin:0 0 1.7rem;padding:0;max-width:var(--col)}
.langs li{display:grid;grid-template-columns:9.5rem minmax(0,1fr);gap:.15rem 1.5rem;padding:.62rem 0;border-top:1px solid var(--rule-soft)}
.langs b{font-family:var(--display);font-weight:600;font-size:.98rem}
