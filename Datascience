.case__body{padding:.2rem 0 1.7rem}
.tags{display:flex;flex-wrap:wrap;gap:.4rem;list-style:none;margin:1.2rem 0 0;padding:0}
.tags li{font-family:var(--display);font-weight:500;font-size:.8rem;color:var(--mute);background:var(--paper-2);padding:.26rem .6rem;border-radius:2px}
.repo{display:inline-block;margin-top:1rem;font-family:var(--display);font-weight:600;font-size:.9rem;color:var(--jade);text-decoration-color:var(--jade)}

