    --field:#272142;--paper:#15121F;--paper-2:#1E1A2C;--ink:#EAE6F0;--mute:#9A94AE;
    --amber:#E2A03F;--jade:#4FB69C;
    --on-field:#EAE6F0;--on-field-mute:#948EAE;
    --rule:rgba(234,230,240,.20);--rule-soft:rgba(234,230,240,.10);--rule-field:rgba(234,230,240,.14);
  }
}
:root[data-theme="dark"]{
  --field:#272142;--paper:#15121F;--paper-2:#1E1A2C;--ink:#EAE6F0;--mute:#9A94AE;
  --amber:#E2A03F;--jade:#4FB69C;
