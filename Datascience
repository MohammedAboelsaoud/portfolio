.standfirst{max-width:var(--measure);font-size:clamp(1.05rem,1rem + .3vw,1.2rem)}
.standfirst + .standfirst{margin-top:.85rem;color:var(--mute)}
.cta{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:clamp(1.5rem,3vw,2.1rem)}
.btn{
  font-family:var(--display);font-weight:600;font-size:.93rem;padding:.62rem 1.15rem;
  border:1px solid var(--ink);border-radius:2px;background:var(--ink);color:var(--paper);
