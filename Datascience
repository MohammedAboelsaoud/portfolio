<style>
/* ============================================================
   tokens
   jade  = the rendered side / anything interactive
   amber = the raw side, the source material
   ============================================================ */
:root{
  --field:#221E38;
  --paper:#EDE9E3;
  --paper-2:#E3DED6;
  --ink:#191627;
  --mute:#5F5A70;
  --amber:#A96C22;
  --jade:#27735F;
  --jade-lit:#4FB69C;
  --on-field:#EFEBE4;
  --on-field-mute:#A29CBE;
  --rule:rgba(25,22,39,.16);
  --rule-soft:rgba(25,22,39,.09);
  --rule-field:rgba(239,235,228,.16);

  --display:"Bricolage Grotesque","Helvetica Neue",Arial,sans-serif;
  --text:"Newsreader",Georgia,"Times New Roman",serif;

  --spine:clamp(15rem,20vw,19.5rem);
  --pad:clamp(1.25rem,4.2vw,4.25rem);
  --measure:66ch;
  --col:56rem;

  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  color-scheme:light dark;
}
